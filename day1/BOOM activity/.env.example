# ---------------------------------------------------------------------------
# Babamul credentials for the ZTF Summer School filtering activity.
#
#   1. Copy this file to `.env`  (cp .env.example .env)
#   2. Fill in the three values below from your Babamul profile page
# ---------------------------------------------------------------------------

# Which Babamul deployment to talk to.
#   production  -> kaboom.caltech.edu   + babamul.caltech.edu/api/babamul
#   backup      -> babamul.umn.edu      + babamul.umn.edu/api/babamul
#   local       -> localhost (only if you are running Babamul yourself)
#
BABAMUL_ENV=production

# Kafka credentials — for reading the alert streams.
# Get these from the /profile page of the deployment above.
BABAMUL_KAFKA_USERNAME=your_username
BABAMUL_KAFKA_PASSWORD=your_password

# API token — for cross-matches, photometry, object lookups and cone searches.
# Same profile page.
BABAMUL_API_TOKEN=your_api_token
